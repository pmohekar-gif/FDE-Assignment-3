# Fixture mode is deterministic, offline, and visibly labelled SIMULATED in the product.
AI_PROVIDER=fixture

# Real structured inference mode:
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OpenRouter experimental live mode. SYNTHETIC DATA ONLY: never send real customer issues.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=minimax/minimax-m3:free
# OPENROUTER_HTTP_REFERER=https://github.com/pmohekar-gif/FDE-Assignment-3
# OPENROUTER_X_TITLE=Warrant
# The MiniMax M3 free endpoint uses json_object; capability defaults are model-specific.
# STRUCTURED_OUTPUT_MODE=json_object
# OpenRouter live experiments default to a 45s safety ceiling (OpenAI defaults to 12s).
# PROVIDER_TIMEOUT_SECONDS=45
# Optional explicit degraded extraction/judge fallback (always visibly simulated):
# AI_FALLBACK_PROVIDER=fixture
PROVIDER_RETRY_BASE_MS=25

DATABASE_PATH=data/warrant.db
WORKSPACE_ID=ws-demo
WEBHOOK_SECRET=replace-with-a-random-secret
CSRF_TOKEN=replace-with-a-random-token
WARRANT_TTL_MINUTES=240
ALLOW_SUFFICIENCY_THRESHOLD=0.70
DEBUG=false
