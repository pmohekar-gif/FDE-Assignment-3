# Fixture mode is deterministic, offline, and visibly labelled SIMULATED in the product.
# AI_PROVIDER=fixture

# Real OpenAI structured inference mode:
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# Experimental live check only. The MiniMax M3 free endpoint is reached through
# OpenRouter, supports JSON output, and is enforced client-side by Warrant's Pydantic
# schemas. Use synthetic assignment data only; never point this endpoint at real
# customer issues, code, credentials, or telemetry.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=minimax/minimax-m3:free
# OPENROUTER_REASONING={"effort":"low"}
# STRUCTURED_OUTPUT_MODE=auto
# PROVIDER_TIMEOUT_SECONDS=45

# Experimental live check only. MiniMax M3 reached through the Grid Dynamics Bifrost
# gateway's OpenAI-compatible adapter. Like OpenRouter, the gateway does NOT enforce
# JSON Schema server-side, so structured output runs in json_object mode and is enforced
# client-side by Warrant's Pydantic schemas. Use synthetic assignment data only; never
# point this endpoint at real customer issues, code, credentials, or telemetry.
# BIFROST_API_KEY is a Bifrost-issued *virtual key*, not an Anthropic or OpenAI API key,
# and is read independently of them. Reaching the gateway may require corporate VPN.
AI_PROVIDER=bifrost
BIFROST_API_KEY=replace-me-with-a-bifrost-virtual-key
BIFROST_BASE_URL=https://bifrost.evergreen.gcp.griddynamics.net/anthropic
# Leave BIFROST_MODEL unset to auto-resolve the tenant's MiniMax M3 id from the gateway
# catalogue (GET /v1/models, cached per key fingerprint). Set it to skip resolution.
BIFROST_MODEL=minimax-m3

# Optional explicit degraded extraction/judge fallback (always visibly simulated):
# AI_FALLBACK_PROVIDER=fixture
PROVIDER_RETRY_BASE_MS=25

DATABASE_PATH=data/warrant.db
WORKSPACE_ID=ws-demo
WEBHOOK_SECRET=replace-with-a-random-secret
CSRF_TOKEN=replace-with-a-random-token
WARRANT_TTL_MINUTES=240
ALLOW_SUFFICIENCY_THRESHOLD=0.70
DEBUG=true

# Contextual Agent and repository-grounded Code Intelligence are local/read-only by default.
AGENT_CHAT_ENABLED=true
CODE_INTELLIGENCE_ENABLED=true
# Coding sessions require REPOSITORY_ROOT to be a real Git checkout, and the delivered
# project folder ships a .gitignore but no .git, so `.` yields a typed 503. `make demo-repo`
# creates a small self-contained checkout here whose files are exactly the seeded issues'
# path_hints and the policy surface globs, so retrieval, warrant scope and session diffs
# all refer to the same paths. Point this at your own checkout for real work; the built-in
# default stays the conservative project root.
REPOSITORY_ROOT=.runtime/demo-repo
DEMO_REPOSITORY_ROOT=.runtime/demo-repo
REPOSITORY_MAX_FILE_BYTES=512000
REPOSITORY_MAX_RESULTS=20

# Real coding is opt-in. Sessions require an active policy-issued warrant and a Git checkout.
EXTERNAL_CODING_AGENT_ENABLED=false
CODING_AGENT_PROVIDER=mock
CODING_SESSION_ROOT=.runtime/coding-sessions
CODING_AGENT_TIMEOUT_SECONDS=900
CODING_AGENT_MAX_OUTPUT_BYTES=1000000

# Verification is discovered from the TARGET repository in priority order: package.json
# scripts -> pyproject.toml/Makefile targets -> simple .github/workflows run steps ->
# VERIFICATION_COMMAND. The demo checkout resolves to `make test` and `make lint`, which
# are stdlib-only and finish in well under a second.
VERIFICATION_DISCOVERY_ENABLED=true
VERIFICATION_MAX_CHECKS=4
VERIFICATION_TIMEOUT_SECONDS=300
# Fallback only, used when nothing is discoverable. Keep it FAST: it runs inside every
# session worktree. `uv run pytest -q` would run this project's whole suite (~5 minutes)
# per session, so it is not a usable default.
VERIFICATION_COMMAND=git diff --check

# Branches no coding session may write to; the target repository's checked-out branch is
# always protected as well. Terminal worktrees and their branches are torn down, keeping
# the newest CODING_SESSION_RETENTION sessions available for review.
PROTECTED_BRANCHES=main,master,production
CODING_SESSION_RETENTION=3

# Optional draft-PR publication through an installed/authenticated gh CLI. Requires `gh`
# on PATH, `gh auth login` completed, and REPOSITORY_ROOT pointing at a checkout whose
# `origin` is a GitHub remote you can push to. Every PR is opened as a DRAFT.
PR_PUBLISHING_ENABLED=true
# Branch the draft PR opens against. Empty = the repository's own default branch.
PR_BASE_BRANCH=
# Default reviewers requested on every published PR: GitHub usernames, or `org/team`
# slugs, comma-separated. A per-request "reviewers" list overrides this. Reviewers must be
# collaborators on the target repository or the request is dropped (the PR still opens,
# and the session timeline records that nobody was asked).
PR_REVIEWERS=

# Optional Slack Events adapter. Ordinary startup never requires these values.
SLACK_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
# JSON map from Slack member IDs to Warrant user IDs, e.g. {"U123":"engineer-demo"}
SLACK_USER_MAP={}
APPLICATION_BASE_URL=

# Mock demo sign-in. This is a demo identity gate, NOT production authentication: one
# shared password for every seeded user, no OAuth/SSO/MFA, no self-registration, no
# password reset, no lockout. Its purpose is to bind the acting identity to a
# server-side session instead of the spoofable X-Actor-Id request header.
# false (default) keeps today's header-driven demo and API behaviour unchanged.
AUTH_ENABLED=true
# Applied to every seeded user (admin-demo, lead-web, lead-payments, engineer-demo, ...).
# Only a per-user salt and a stdlib scrypt derivation are stored; the password itself
# never reaches the database. Change it here, restart, and the hashes are re-derived.
DEMO_PASSWORD=warrant-demo
# HMAC key for HS256 JWTs used as browser cookies and API bearer tokens. Replace with at
# least 32 random bytes; rotating it invalidates every existing session. Placeholder only.
SESSION_SECRET=replace-with-a-random-session-secret
# JWT lifetime in minutes; also the cookie Max-Age. The cookie is HttpOnly and
# SameSite=Lax, and Secure whenever DEBUG=false.
SESSION_TTL_MINUTES=720
