{
  "description": "Warrant control plane: lint after Python edits, restate the test standard on stop.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(pwd)/.codex/hooks/ruff_check.sh\"",
            "statusMessage": "ruff check src tests",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(pwd)/.codex/hooks/stop_reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
